{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datalogicengine.local/contracts/functions.schema.json",
  "title": "DVSS Function Bindings Configuration",
  "description": "Validates config/functions.yaml (DLE-SDD §6, FR-FN-01..03, ADR-009, ADR-010).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "functions"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "level",
          "legacy_ka",
          "version",
          "hooks",
          "layers",
          "component",
          "can_hold",
          "permissions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DVSS-(K(0[1-9]|1[0-2])|P(0[1-9]|1[0-4]))$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string",
            "enum": ["kernel", "policy"]
          },
          "legacy_ka": {
            "type": "string",
            "pattern": "^KA-\\d{3}$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "hooks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^L([1-9]|10)$"
            }
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "can_hold": {
            "type": "boolean"
          },
          "host_fallback": {
            "type": "string",
            "enum": ["none", "required"]
          },
          "runtime": {
            "type": "boolean"
          },
          "permissions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reads", "writes"],
            "properties": {
              "reads": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "writes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
