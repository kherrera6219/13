{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dle.local/contracts/registry/axis4_branch.schema.json",
  "title": "Axis 4 Branch: a promoted subfield beneath one pillar or one sector",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string",
      "pattern": "^\\[BR:4\\.(?:1\\.[1-9][0-9]*|2\\.(?:[1-9]|1[0-9]|20))(?:\\.[1-9][0-9]*)+\\]$",
      "description": "[BR:4.1.<pillar>.<i>...] under a pillar, or [BR:4.2.<sector>.<naics digits>...] under a sector"
    },
    "root": {
      "type": "string",
      "pattern": "^(?:PL[0-9]{3}|SC[0-9]{2})$"
    },
    "parent": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\[BR:4\\."
        },
        {
          "type": "null"
        }
      ],
      "description": "null when the parent is the root"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "naics_2022": {
      "type": "string",
      "pattern": "^[0-9]{3,6}$",
      "description": "Required for sector-rooted branches"
    },
    "promoted_from": {
      "type": "string",
      "description": "TMP node UUID the branch was promoted from"
    },
    "status": {
      "enum": [
        "proposed",
        "verified",
        "retired",
        "fixture"
      ],
      "description": "Only verified records may support a binding claim. proposed: discovery only. fixture: tests only, never loaded in production."
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_to": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "jurisdiction": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\[[A-Z][A-Z0-9-]*:(?:1[0-3]|[1-9])(?:\\.(?:0|[1-9][0-9]*))+\\]$",
          "description": "Canonical permanent atom, e.g. [PL:1.27.0.0]"
        },
        {
          "enum": [
            "unscoped",
            "unknown"
          ]
        }
      ]
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "branch_id",
    "root",
    "parent",
    "label",
    "depth",
    "status",
    "owner",
    "valid_from"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "root": {
            "pattern": "^SC"
          }
        }
      },
      "then": {
        "required": [
          "naics_2022"
        ]
      }
    }
  ]
}