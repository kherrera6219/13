{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dle.local/contracts/functions/p08.out.json",
  "title": "DVSS_P08_Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["total_tokens", "strategy", "allocation", "mass_by_role"],
  "properties": {
    "total_tokens": { "type": "integer", "minimum": 0 },
    "strategy": { "type": "string", "enum": ["ppr_mass", "equal_split"] },
    "allocation": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "mass_by_role": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0 }
    }
  }
}
