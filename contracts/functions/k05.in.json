{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dle.local/contracts/functions/k05.in.json",
  "title": "DVSS_K05_Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "idempotency_key"],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["retrieve", "authority_check"]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "scope_start": {
      "type": ["string", "null"],
      "format": "date"
    },
    "scope_end": {
      "type": ["string", "null"],
      "format": "date"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "binding": {
      "type": "boolean"
    },
    "attached_passage_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
