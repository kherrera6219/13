{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dle.local/contracts/functions/k03.in.json",
  "title": "DVSS_K03_Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["role_axis", "candidates"],
  "properties": {
    "role_axis": { "type": "integer", "minimum": 8, "maximum": 11 },
    "tier": { "type": "integer", "enum": [1, 2, 3] },
    "p10_enabled": { "type": "boolean" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "role_axis", "mandatory_met"],
        "properties": {
          "profile_id": { "type": "string", "minLength": 1 },
          "role_axis": { "type": "integer", "minimum": 8, "maximum": 11 },
          "mandatory_met": { "type": "boolean" },
          "direct_e": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "direct_c": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "direct_x": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "matched_credentials": { "type": ["integer", "null"], "minimum": 0 },
          "sector_lineage_match": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
