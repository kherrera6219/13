{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dle.local/contracts/functions/k07.in.json",
  "title": "DVSS_K07_Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["anchors", "tier", "retry_count"],
  "properties": {
    "anchors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "tier": {
      "type": "integer",
      "enum": [1, 2, 3]
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "damping": { "type": "number", "minimum": 0.1, "maximum": 0.99 },
    "max_iterations": { "type": "integer", "minimum": 1, "maximum": 80 },
    "tolerance": { "type": "number", "exclusiveMinimum": 0 },
    "max_vertices": { "type": "integer", "minimum": 1, "maximum": 250 },
    "max_edges": { "type": "integer", "minimum": 1 },
    "max_tokens": { "type": "integer", "minimum": 1 }
  }
}
