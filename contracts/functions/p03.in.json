{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dle.local/contracts/functions/p03.in.json",
  "title": "DVSS_P03_Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_uuid", "label", "anchor_atoms"],
  "properties": {
    "session_uuid": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "anchor_atoms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "depth": { "type": "integer", "minimum": 1, "maximum": 7 },
    "via_links": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
