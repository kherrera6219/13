{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dle.local/contracts/functions/p03.out.json",
  "title": "DVSS_P03_Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["canonical_str", "is_hypothesis", "citeable_as_evidence", "status"],
  "properties": {
    "canonical_str": {
      "type": "string",
      "pattern": "^\\[TMP:5\\.TMP\\.[0-9a-f-]{36}\\]$"
    },
    "is_hypothesis": { "const": true },
    "citeable_as_evidence": { "const": false },
    "status": { "const": "synthetic_derived" },
    "depth": { "type": "integer", "minimum": 1, "maximum": 7 }
  }
}
